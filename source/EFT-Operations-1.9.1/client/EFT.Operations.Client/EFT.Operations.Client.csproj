<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Intentional TFM choice for this pinned installation:
    EFT UnityPlayer is 2022.3.43f1 and its Managed folder contains netstandard.dll,
    but the selected BepInEx 5.4.22.0, Fika.Core 1.2.3.0 and SPT Common 3.11.1.0
    assemblies declare .NETFramework v4.7.1. net472 is the compatible higher
    framework target for those references. Re-evaluate only if the pinned runtime
    or dependency set changes; verify with a Windows build and an in-game load test.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>EFTOperations.Client</AssemblyName>
    <RootNamespace>EFTOperations.Client</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">C:\SPT\EscapeFromTarkov_Data\Managed</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">C:\SPT\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(GameManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GameManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
